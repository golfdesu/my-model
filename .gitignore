# 1. Ignore everything at root except whitelisted entries below
/*
!/**/

# 2. Whitelist numbered experiment scripts, tools, and environment dependencies
![0-9]*
!**/[0-9]*
!tools/
!tools/**
!requirements.txt
!.gitignore
!AGENTS.md
!CLAUDE.md
!*.sbatch

# 3. Keep ignoring duplicated "*_fix" copies of numbered scripts
*[0-9]*fix
*[0-9]*fix.*
**/*[0-9]*fix
**/*[0-9]*fix.*

# 4. Python cache
__pycache__/
**/__pycache__/**
*.py[cod]
*$py.class

.venv/
**/.venv/**

# 5. Local documentation, traces, configs, and logs
.agents/
.wikiskill/
archive/
configs/
docs/
logs/
plots/
secret vault.txt
*vault*.txt


# 6. Benchmark results and model artifacts
*_results.json
*_predictions.npz
*_best.pt
outputs/
outputs/**
